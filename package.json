{
  "name": "nightly-tests",
  "description": "Nightly integration tests for React Native",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "website"
  ],
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://react-native-community.github.io/nightly-tests",
  "bugs": {
    "url": "https://github.com/react-native-community/nightly-tests/issues"
  },
  "repository": "github:react-native-community/nightly-tests",
  "devDependencies": {
    "globals": "^17.13.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-golden": "^0.1.2",
    "oxlint-plugin-react-doctor": "^0.9.22",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "7.0.2"
  },
  "resolutions": {
    "postcss": "^8.5.31"
  },
  "scripts": {
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "test": "bun test ./.github/workflow-scripts/__tests__/*.test.js",
    "test:watch": "bun test --watch ./.github/workflow-scripts/__tests__/*.test.js"
  },
